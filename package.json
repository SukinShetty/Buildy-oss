{
  "name": "buildy",
  "version": "1.0.0",
  "description": "Your AI builder buddy — helps non-tech founders build with Claude Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SukinShetty/Buildy-oss.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "nemp-mcp-server": "^0.2.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.buildy.app",
    "productName": "Buildy",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
